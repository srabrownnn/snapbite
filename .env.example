# SnapBite Environment Variables Configuration Example
# Copy this file to .env.local and populate with your Supabase credentials

# 1. Supabase Project Credentials (Found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# 2. Public Application URL (Used for generating table QR codes and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. Optional Payment Gateways (bKash / Nagad / Stripe)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
STRIPE_SECRET_KEY=
